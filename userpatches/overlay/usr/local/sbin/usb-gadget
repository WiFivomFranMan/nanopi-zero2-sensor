#!/bin/bash
set -euo pipefail

G=/sys/kernel/config/usb_gadget/nanopi-zero2

get_serial()
{
    local serial=""

    # Vendor 6.1 exposes the SoC serial as a "Serial:" line in /proc/cpuinfo; mainline arm64
    # does not. U-Boot writes it into the device tree for both, so prefer that (it is also what
    # wc-hostname derives the hostname from), then cpuinfo, then the machine id.
    if [ -r /proc/device-tree/serial-number ]; then
        serial=$(tr -d '\0' < /proc/device-tree/serial-number)
    fi

    if [ -z "$serial" ]; then
        serial=$(awk -F': *' '/^Serial/ { print $2 }' /proc/cpuinfo)
    fi

    if [ -z "$serial" ] && [ -r /etc/machine-id ]; then
        serial=$(tr -d '\n' </etc/machine-id)
    fi

    echo "${serial:-0000000000000000}"
}

start()
{
    modprobe libcomposite

    mountpoint -q /sys/kernel/config || \
        mount -t configfs none /sys/kernel/config

    local udc
    udc=$(ls /sys/class/udc 2>/dev/null | head -n1)

    # On mainline the USB-C port is a dwc3 in OTG mode whose role is decided by the usb2phy's
    # VBUS/ID sensing from a queued work item, so the UDC can appear after this unit has run,
    # or only once a host cable is plugged in. That is not an error: a udev rule
    # (90-usb-gadget-udc.rules) re-runs this script when a UDC is added.
    [ -n "$udc" ] || {
        echo "No USB Device Controller yet; will bind when one appears." >&2
        exit 0
    }

    mkdir -p "$G"
    cd "$G"

    # Already bound to this controller: nothing to do (idempotent for the udev re-run).
    if [ -f UDC ] && [ "$(cat UDC 2>/dev/null)" = "$udc" ]; then
        exit 0
    fi

    # Unbind first in case we're already active on a different/old controller.
    echo "" > UDC 2>/dev/null || true

    echo 0x2207 > idVendor
    echo 0x0019 > idProduct
    echo 0x0200 > bcdUSB
    echo 0x0310 > bcdDevice

    mkdir -p strings/0x409
    echo "$(get_serial)" > strings/0x409/serialnumber
    echo "FriendlyElec" > strings/0x409/manufacturer
    echo "NanoPi Zero2" > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    echo "USB Ethernet" > configs/c.1/strings/0x409/configuration
    echo 250 > configs/c.1/MaxPower

    mkdir -p functions/ncm.usb0

    [ -L configs/c.1/ncm.usb0 ] || \
        ln -s functions/ncm.usb0 configs/c.1/

    echo "$udc" > UDC
}

stop()
{
    [ -d "$G" ] || exit 0

    cd "$G"

    echo "" > UDC 2>/dev/null || true

    rm -f configs/c.1/ncm.usb0

    rmdir functions/ncm.usb0 2>/dev/null || true

    rmdir configs/c.1/strings/0x409 2>/dev/null || true
    rmdir configs/c.1 2>/dev/null || true
    rmdir configs 2>/dev/null || true

    rmdir strings/0x409 2>/dev/null || true
    rmdir strings 2>/dev/null || true

    cd /

    rmdir "$G" 2>/dev/null || true
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
