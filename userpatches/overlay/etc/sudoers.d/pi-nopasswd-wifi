# WLAN Commander drives these over SSH as `sudo -n`, which fails immediately rather
# than prompting when a password is required. The upstream list covers scan/capture
# (iw/ip/tcpdump/dumpcap); the rest cover the interface-busy recovery path, which
# builds `sudo pgrep -f <pat>` then kills the matches (core/src/ssh/commands.rs).
# Without them that recovery is silently inert -- it "runs" and finds nothing.
#
# ip is listed at BOTH paths deliberately: the binary is /usr/bin/ip here, and the
# upstream /usr/sbin/ip entry only matches because sudo's secure_path happens to try
# /usr/sbin first. Pinning both survives a path change.
pi ALL=(ALL) NOPASSWD: /usr/sbin/iw, /usr/sbin/ip, /usr/bin/ip, /usr/bin/tcpdump, /usr/bin/dumpcap, /usr/bin/pgrep, /usr/bin/pkill, /usr/bin/kill, /usr/bin/systemctl
